# Masiez backend — copy to .env and adjust. All values are optional; the
# defaults below match what the server uses when the variable is absent.

HTTP_PORT=3001
WS_GAME_PATH=/ws/game
WS_AI_PATH=/ws/ai
API_BASE_PATH=/api/v1
CORS_ORIGINS=*
TELEMETRY_BUFFER_SECONDS=300
MAX_SESSIONS=100

# Default spawn map for new sessions
MAP_ID=airfield

# Where recorded flights and leaderboard rows are written (relative to the
# server working directory unless given as an absolute path).
REPLAY_DIR=./data/replays
LEADERBOARD_FILE=./data/leaderboard.json

# LiveKit teleoperation is an alternative path, disabled by default.
# Generate real key/secret for anything beyond localhost; never commit them.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_1234
LIVEKIT_ROOM=drone
